# PORT: The port the full-stack server listens on (defaults to 3000)
PORT="3000"

# JWT_SECRET: Secret key used to sign and verify session JWT tokens
JWT_SECRET="limbando_school_jwt_secret_key_2026_super_secure"

# DATABASE_URL: Optional SQLite or PostgreSQL database path (defaults to file:./data/school.db)
DATABASE_URL="file:./data/school.db"

# GEMINI_API_KEY: Required for Gemini AI attendance briefings, truancy prediction, and NL queries
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
